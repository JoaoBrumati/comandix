{
  "name": "comandix",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de pedidos e pagamento do Comandix",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node back/server.js",
    "dev": "vite",
    "server": "node --watch back/server.js",
    "build": "prisma generate && tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:import-legacy": "node back/scripts/import-legacy-admin-store.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.89.0",
    "prisma": "6.12.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}

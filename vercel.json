{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin-handler?__admin_path=:path*"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/login",
      "destination": "/"
    }
  ]
}
